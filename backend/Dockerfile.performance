# Stage 1: Build TypeScript Telemetry Collector
FROM node:22-bookworm-slim AS collector-build
WORKDIR /build
COPY telemetry-collector/package.json telemetry-collector/tsconfig.json ./
RUN npm install
COPY telemetry-collector/src ./src
RUN npm run build

# Stage 2: Unified Single-Container Performance Engine (Node.js :8787 + Python FastAPI :8000)
FROM python:3.11-slim-bookworm
WORKDIR /app

# Copy Node.js binary from Stage 1 (both use Debian Bookworm glibc)
COPY --from=collector-build /usr/local/bin/node /usr/local/bin/node

# Copy compiled Telemetry Collector (:8787)
COPY --from=collector-build /build/dist /app/telemetry-collector/dist
COPY --from=collector-build /build/package.json /app/telemetry-collector/package.json
COPY --from=collector-build /build/node_modules /app/telemetry-collector/node_modules

# Install Python Anomaly & P-Score dependencies (:8000)
COPY performance/anomaly-detection/requirements.txt /app/anomaly-detection/requirements.txt
RUN pip install --no-cache-dir -r /app/anomaly-detection/requirements.txt

# Copy Python Anomaly & P-Score Engine source
COPY performance/anomaly-detection /app/anomaly-detection
COPY start_performance_engine.py /app/start_performance_engine.py

ENV PORT=8787
ENV COLLECTOR_URL=http://127.0.0.1:8787

EXPOSE 8787 8000

CMD ["python", "/app/start_performance_engine.py"]
